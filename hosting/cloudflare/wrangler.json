{
  "name": "xiaowei-academic-homepage",
  "main": "worker.ts",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiaowei-homepage-visitors",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
